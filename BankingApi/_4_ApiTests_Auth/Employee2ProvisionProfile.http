@adminRights = 255

### 1a) Create Employee on IA-Provider (Dev-only)

POST {{authServer}}/dev/users
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "confirmPassword": "{{password}}",
  "accountType": "{{accountType}}",
  "adminRights": {{adminRights}},
  "mustChangePassword": false
}

> {%
    client.test("Employee created", function() {
        client.assert(response.status === 201, "Expected HTTP 201");
    });
%}

### 1b) Get a bearer token scope=openid profile offline_access {{apiScope}}
POST {{authServer}}/connect/token
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=dev_password
    &client_id={{devClientId}}
    &email={{email}}
    &password={{password}}
    &scope={{apiScope}}

> {%
    client.test("Employee token created", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(!!response.body.access_token, "Missing access_token");
    });

    client.global.set("accessToken", response.body.access_token);
%}

###
# @name 1c) Post employee provision
POST {{baseUrl}}/employees/me/provision?id={{id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}


###
# @name 1d) Put employee provfile
PUT {{baseUrl}}/employees/me/profile
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessToken}}

{
  "id": "{{id}}",
  "firstname": "{{firstname}}",
  "lastname": "{{lastname}}",
  "email": "{{email}}",
  "phone": "{{phone}}",
  "subject": "xxxxx",
  "adminrights": {{adminRights}},
  "personnelnumber": "{{personnelNumber}}"
}